# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT (Postgres on your machine)
# ─────────────────────────────────────────────────────────────────────────────
# Two roles on purpose: `constructflow` is RLS-forced (the app), `constructflow_auth`
# has BYPASSRLS and is used only for pre-login lookups. See README "Getting started".
DATABASE_URL="postgresql://constructflow:constructflow@127.0.0.1:5432/constructflow_dev"
AUTH_DATABASE_URL="postgresql://constructflow_auth:constructflow@127.0.0.1:5432/constructflow_dev"

# Show the one-click demo logins + shared demo password on the sign-in page.
# Auto-on in dev. Set "true" to also show them on a hosted DEMO; leave unset/false
# for a real client deployment.
NEXT_PUBLIC_DEMO_LOGINS="true"

# ─────────────────────────────────────────────────────────────────────────────
# CLOUD (Supabase + Vercel) — see docs/DEPLOY.md for the full runbook
# ─────────────────────────────────────────────────────────────────────────────
# App on Vercel → Supabase TRANSACTION pooler (port 6543). TLS and a small pool
# are applied automatically for non-local hosts (src/db/pg-options.ts), so just
# paste the pooler URLs:
#   DATABASE_URL="postgresql://constructflow.<PROJECT_REF>:<APP_PW>@aws-0-<REGION>.pooler.supabase.com:6543/postgres"
#   AUTH_DATABASE_URL="postgresql://constructflow_auth.<PROJECT_REF>:<AUTH_PW>@aws-0-<REGION>.pooler.supabase.com:6543/postgres"
#
# Provisioning from local (db:push / db:rls / db:seed) → SESSION pooler (port 5432).
# Optional override for the per-instance pool size (defaults to 1 for remote hosts):
#   DB_POOL_MAX="1"
#
# NOTE: SESSION_SECRET and STORAGE_DIR from older docs are NOT read by the app —
# sessions are random tokens hashed with sha256, and attachments live in Postgres.
